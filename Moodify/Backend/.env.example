NODE_ENV=production
PORT=5000
CORS_ORIGIN=https://your-frontend-service.onrender.com
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-imagekit-id
PREVIEW_SONG_SOURCE_URL=https://youtu.be/FF-_QBizdZQ
PREVIEW_SONG_DIRECT_URL=
PREVIEW_SONG_CACHE_TTL_SECONDS=604800
SONG_CACHE_TTL_SECONDS=3600
DEBUG_SONG_FLOW=false
